# Private working notes, never committed
CLAUDE.local.md

# Secrets and cloud credentials
.env
.env.*
*.key
*.pem
.aws/

# Terraform
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
crash.log

# Python
__pycache__/
*.py[cod]
.venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
dist/
build/
*.egg-info/

# Data. Nothing raw is committed, and nothing row-level derived from the
# competition data either: its rules forbid making the data available to
# anyone who has not accepted them, and a per-transaction feature store is a
# transformed copy rather than a published result. See docs/data.md, and
# tests/test_data_terms.py, which asserts these rules still exist.
data/
!data/.gitkeep

# Local stores, logs, models
*.sqlite
*.sqlite3
mlruns/
feature_repo/data/
loadtest/results/raw/
*.onnx
# Except the models that ship in the image. Only synthetic-track models go
# here: nothing trained on the competition data may be redistributed
# (docs/data.md, ADR 19), and those live outside the repository entirely.
!verdict/models/artifacts/*.onnx

# OS and editors
.DS_Store
Thumbs.db
.vscode/
.idea/
