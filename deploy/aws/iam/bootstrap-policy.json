{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadAccountFactsInRegion",
      "Effect": "Allow",
      "Action": [
        "ec2:DescribeRegions",
        "ec2:DescribeAvailabilityZones",
        "ec2:DescribeInstanceTypes",
        "ec2:DescribeInstanceTypeOfferings",
        "ec2:DescribeSpotPriceHistory",
        "servicequotas:GetServiceQuota",
        "servicequotas:GetAWSDefaultServiceQuota",
        "servicequotas:ListServiceQuotas",
        "tag:GetResources",
        "tag:GetTagKeys",
        "tag:GetTagValues",
        "ssm:DescribeParameters"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ca-central-1"
        }
      }
    },
    {
      "Sid": "ReadCostsAndBudgets",
      "Effect": "Allow",
      "Action": [
        "ce:GetCostAndUsage",
        "ce:ListCostAllocationTags",
        "budgets:ViewBudget"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ProjectBudgetsOnly",
      "Effect": "Allow",
      "Action": [
        "budgets:ModifyBudget",
        "budgets:TagResource",
        "budgets:ListTagsForResource"
      ],
      "Resource": "arn:aws:budgets::*:budget/verdict-*"
    },
    {
      "Sid": "ProjectParametersOnly",
      "Effect": "Allow",
      "Action": [
        "ssm:PutParameter",
        "ssm:GetParameter",
        "ssm:DeleteParameter",
        "ssm:AddTagsToResource",
        "ssm:ListTagsForResource"
      ],
      "Resource": "arn:aws:ssm:ca-central-1:*:parameter/verdict/*"
    },
    {
      "Sid": "PublicAmiLookup",
      "Effect": "Allow",
      "Action": [
        "ssm:GetParameter",
        "ssm:GetParameters"
      ],
      "Resource": "arn:aws:ssm:ca-central-1::parameter/aws/service/*"
    }
  ]
}
