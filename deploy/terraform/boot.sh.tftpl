#!/bin/bash
# Runs once, as root, on the first boot of every instance the auto-scaling
# group launches: a fresh one, or the replacement after a spot interruption.
# It attaches the data volume, prepares Docker, and starts the live stack.
# Rendered by Terraform (compute.tf); its log is /var/log/verdict-boot.log.
set -euo pipefail
exec > >(tee -a /var/log/verdict-boot.log) 2>&1
echo "boot started $(date -u +%Y-%m-%dT%H:%M:%SZ)"

REGION="${region}"
VOLUME_ID="${volume_id}"

# The instance's own id, through IMDSv2.
IMDS_TOKEN=$(curl -fsS -X PUT http://169.254.169.254/latest/api/token \
  -H "X-aws-ec2-metadata-token-ttl-seconds: 300")
INSTANCE_ID=$(curl -fsS -H "X-aws-ec2-metadata-token: $IMDS_TOKEN" \
  http://169.254.169.254/latest/meta-data/instance-id)

# Docker from the distribution, Compose as a pinned, checksummed plugin.
dnf install -y docker
systemctl enable --now docker
mkdir -p /usr/local/lib/docker/cli-plugins
curl -fsSL -o /usr/local/lib/docker/cli-plugins/docker-compose \
  "https://github.com/docker/compose/releases/download/${compose_version}/docker-compose-linux-x86_64"
echo "${compose_sha256}  /usr/local/lib/docker/cli-plugins/docker-compose" | sha256sum -c -
chmod +x /usr/local/lib/docker/cli-plugins/docker-compose

# The data volume. After a spot interruption the old instance may still hold
# it for a while, so wait for it to become available rather than fail.
for attempt in $(seq 1 60); do
  state=$(aws ec2 describe-volumes --region "$REGION" --volume-ids "$VOLUME_ID" \
    --query 'Volumes[0].State' --output text)
  if [ "$state" = "available" ]; then
    aws ec2 attach-volume --region "$REGION" --volume-id "$VOLUME_ID" \
      --instance-id "$INSTANCE_ID" --device /dev/sdf
    break
  fi
  echo "volume is $state, attempt $attempt of 60"
  sleep 10
done

# On Nitro instances the device is NVMe and its name is not stable; its
# by-id link carries the volume id without the dash.
DEVICE="/dev/disk/by-id/nvme-Amazon_Elastic_Block_Store_$${VOLUME_ID/-/}"
for attempt in $(seq 1 60); do
  [ -e "$DEVICE" ] && break
  sleep 2
done
[ -e "$DEVICE" ] || { echo "data volume never appeared at $DEVICE"; exit 1; }

# A filesystem only if there is none: the first boot of the stack's life.
# Every later boot, including every replacement, mounts what is there.
if ! blkid "$DEVICE" >/dev/null 2>&1; then
  echo "no filesystem on the data volume: first boot, making one"
  mkfs.xfs "$DEVICE"
fi
mkdir -p /data
UUID=$(blkid -s UUID -o value "$DEVICE")
grep -q "$UUID" /etc/fstab || echo "UUID=$UUID /data xfs defaults,nofail 0 2" >> /etc/fstab
mount -a
mountpoint -q /data

# Each service owns its directory on the data volume, by the uid its image
# runs as: Redpanda 101, the platform's image 10001 (deploy/image), and
# Prometheus 65534. The feeds' saved places are what let a replacement
# carry on the stream where it stopped (ADR 15).
mkdir -p /data/redpanda /data/history /data/feeds /data/flags /data/grafana /data/prometheus /data/alerts/outbox
chown 101:101 /data/redpanda
chown 10001:10001 /data/history /data/feeds /data/flags /data/grafana /data/alerts /data/alerts/outbox
chown 65534:65534 /data/prometheus

# Spot notices, kept on the data volume so they outlive the instance they
# name. The live report leaves a reclaim's recovery out of the latency
# figure only with AWS's own notice as the evidence (ADR 25), so every boot
# is recorded, and a watcher waits for the notice and writes it down.
mkdir -p /data/interruptions
INSTANCE_TYPE=$(curl -fsS -H "X-aws-ec2-metadata-token: $IMDS_TOKEN" \
  http://169.254.169.254/latest/meta-data/instance-type)
printf '{"instance_id":"%s","instance_type":"%s","booted_at":"%s"}\n' \
  "$INSTANCE_ID" "$INSTANCE_TYPE" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" >> /data/interruptions/boots.jsonl
cat > /usr/local/bin/verdict-spot-watch <<'WATCH'
#!/bin/bash
# Waits for this instance's spot interruption notice and records it.
id=$1
while true; do
  token=$(curl -fsS -X PUT http://169.254.169.254/latest/api/token \
    -H "X-aws-ec2-metadata-token-ttl-seconds: 60") || { sleep 5; continue; }
  if notice=$(curl -fsS -H "X-aws-ec2-metadata-token: $token" \
      http://169.254.169.254/latest/meta-data/spot/instance-action); then
    printf '{"instance_id":"%s","noticed_at":"%s","notice":%s}\n' \
      "$id" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$notice" > "/data/interruptions/$id.json.tmp"
    mv "/data/interruptions/$id.json.tmp" "/data/interruptions/$id.json"
    sync
    exit 0
  fi
  sleep 5
done
WATCH
chmod 755 /usr/local/bin/verdict-spot-watch
systemd-run --unit=verdict-spot-watch /usr/local/bin/verdict-spot-watch "$INSTANCE_ID"

# Alerts (ADR 26): the alerts container writes messages to an outbox, and
# this sends each as the instance's role, which no container can reach.
cat > /usr/local/bin/verdict-alert-send <<'SEND'
#!/bin/bash
cd /data/alerts/outbox || exit 1
while true; do
  for f in *.json; do
    [ -e "$f" ] || break
    aws sns publish --region "$1" --topic-arn "$2" --cli-input-json "file://$f" >/dev/null && rm -f "$f"
  done
  sleep 15
done
SEND
chmod 755 /usr/local/bin/verdict-alert-send
systemd-run --unit=verdict-alert-send -p Restart=always /usr/local/bin/verdict-alert-send "$REGION" "${alert_topic_arn}"

# The tunnel token, from SSM, into a root-only file on the disposable root
# volume. It is never written to the data volume, the log, or the repository.
mkdir -p /etc/verdict
umask 077
printf 'TUNNEL_TOKEN=%s\n' "$(aws ssm get-parameter --region "$REGION" \
  --name /verdict/cloudflare-tunnel-token --with-decryption \
  --query Parameter.Value --output text)" > /etc/verdict/tunnel.env
umask 022

# The platform's image, pulled from this stack's own repository by the
# instance's role. Which image is a Terraform variable, so it is in the plan.
aws ecr get-login-password --region "$REGION" \
  | docker login --username AWS --password-stdin "${registry}"

# The sealed schedule, on the live window only: the secret from SSM, where
# Peter put it at sealing, and the committed hashes from the repository. Both
# on the disposable root volume, readable by the feeds' user and nobody else.
mkdir -p /etc/verdict/schedule
if [ "${schedule}" = "sealed" ]; then
  umask 077
  aws ssm get-parameter --region "$REGION" --name /verdict/schedule-secret \
    --with-decryption --query Parameter.Value --output text > /etc/verdict/schedule/secret
  echo "${commitment_b64}" | base64 -d > /etc/verdict/schedule/commitment.json
  umask 022
fi
chown -R 10001:10001 /etc/verdict/schedule
chmod 700 /etc/verdict/schedule

# What the stack runs, root-only: the image, the window and its schedule, and
# a Grafana admin password nobody needs, random per boot (the dashboard is
# anonymous and read-only).
umask 077
{
  printf 'VERDICT_IMAGE=%s\n' "${image}"
  printf 'VERDICT_WINDOW_START=%s\n' "${window_start}"
  printf 'VERDICT_SCHEDULE=%s\n' "${schedule}"
  printf 'GRAFANA_ADMIN_PASSWORD=%s\n' "$(openssl rand -hex 24)"
} > /etc/verdict/stack.env
umask 022

# The stack itself: deploy/live/compose.yml, carried in this script.
mkdir -p /opt/verdict
echo "${compose_b64gz}" | base64 -d | gunzip > /opt/verdict/compose.yml
# The broker first, then the topics job, then everything else: the same order
# the local stack and CI use, and for the same reason (a one-shot job is not a
# service to wait on).
COMPOSE="docker compose -f /opt/verdict/compose.yml --env-file /etc/verdict/stack.env --env-file /etc/verdict/tunnel.env"
$COMPOSE up -d --wait redpanda
$COMPOSE run --rm topics
$COMPOSE run --rm grafana-files
$COMPOSE up -d --wait

echo "boot finished $(date -u +%Y-%m-%dT%H:%M:%SZ)"
